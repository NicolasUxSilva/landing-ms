---
import Icon from './Icon.astro';
import { CONTACT, whatsappUrl } from '../config/site';

const wa = whatsappUrl('Olá! Quero uma proposta de servidor dedicado para a minha empresa.');
---

<section class="final on-dark" aria-labelledby="final-title">
  <div class="final-bg" aria-hidden="true"></div>
  <div class="container final-inner">
    <h2 id="final-title">Pronto para dimensionar o seu servidor?</h2>
    <p>Comece pelo simulador ou converse direto com um especialista. A proposta sai depois da validação técnica, sem compromisso.</p>
    <div class="final-actions">
      <a class="btn btn--primary btn--lg" href="#configurar" data-sim-start data-track="cta_click" data-track-location="cta-final">
        Simular meu servidor <Icon name="arrow-right" class="btn-arrow" />
      </a>
      <a class="btn btn--outline-dark btn--lg" href={wa} target="_blank" rel="noopener" data-track="contact_whatsapp_click" data-track-location="cta-final">
        <Icon name="whatsapp" class="wa-icon" /> WhatsApp {CONTACT.whatsappDisplay}
      </a>
    </div>
    <p class="final-meta">
      <a href={`tel:${CONTACT.phoneE164}`}><Icon name="phone" size={16} /> {CONTACT.phoneDisplay}</a>
      <a href={`mailto:${CONTACT.emailCommercial}`}><Icon name="mail" size={16} /> {CONTACT.emailCommercial}</a>
      <span><Icon name="clock" size={16} /> {CONTACT.hours}</span>
    </p>
  </div>
</section>

<style>
  .final {
    position: relative;
    padding-block: clamp(4.5rem, 3rem + 5vw, 7.5rem);
    background: var(--c-indigo-950);
    color: var(--c-on-dark);
    overflow: hidden;
    isolation: isolate;
  }

  .final-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 90% at 50% 120%, rgb(249 131 5 / 0.28), transparent 70%),
      radial-gradient(50% 60% at 90% 0%, rgb(61 58 134 / 0.55), transparent 70%);
  }

  .final-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image:
      repeating-linear-gradient(30deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 34px),
      repeating-linear-gradient(150deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 34px);
    mask-image: radial-gradient(70% 80% at 50% 60%, #000, transparent);
    -webkit-mask-image: radial-gradient(70% 80% at 50% 60%, #000, transparent);
  }

  .final-inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .final h2 {
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.6rem);
    max-width: 18ch;
  }

  .final-inner > p:not(.final-meta) {
    margin-top: 1.25rem;
    max-width: 52ch;
    color: var(--c-on-dark-2);
    font-size: var(--t-lead);
  }

  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .final-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin-top: 2.25rem;
    color: var(--c-on-dark-2);
    font-size: 0.92rem;
  }

  .final-meta a,
  .final-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
  }

  .final-meta a:hover {
    color: var(--c-on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 520px) {
    .final-actions .btn {
      width: 100%;
    }
  }
</style>
