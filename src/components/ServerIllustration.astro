---
// Ilustração técnica original de um servidor 2U (vista frontal). Não representa
// um modelo ou fabricante específico.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const bays = Array.from({ length: 12 }, (_, i) => i);
const ledDelay = [0.2, 1.4, 0.7, 2.1, 0.4, 1.8, 1.1, 0.9, 2.4, 0.3, 1.6, 0.6];
---

<svg class:list={['server-illustration', className]} viewBox="0 0 720 214" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="srv-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b2964" />
      <stop offset="1" stop-color="#1a1944" />
    </linearGradient>
    <linearGradient id="srv-bay" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2e2c6c" />
      <stop offset="1" stop-color="#211f52" />
    </linearGradient>
    <linearGradient id="srv-sheen" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.14" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <pattern id="srv-perf" width="9" height="9" patternUnits="userSpaceOnUse">
      <circle cx="4.5" cy="4.5" r="1.7" fill="#0c0b22" />
    </pattern>
    <radialGradient id="srv-shadow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#000" stop-opacity="0.55" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
  </defs>

  <ellipse cx="360" cy="200" rx="330" ry="12" fill="url(#srv-shadow)" />

  <rect x="8" y="16" width="704" height="168" rx="10" fill="url(#srv-body)" stroke="#ffffff" stroke-opacity="0.14" />
  <rect x="20" y="17" width="680" height="1.5" fill="url(#srv-sheen)" />

  <!-- Orelha esquerda -->
  <rect x="8" y="16" width="46" height="168" rx="10" fill="#17163d" />
  <circle cx="31" cy="48" r="9" stroke="#8f8ce0" stroke-opacity="0.55" stroke-width="1.5" />
  <path d="M31 43.5v4.5" stroke="#8f8ce0" stroke-opacity="0.8" stroke-width="1.5" stroke-linecap="round" />
  <circle class="srv-led srv-led--steady" cx="31" cy="78" r="2.6" fill="#4eb3f4" />
  <circle class="srv-led srv-led--steady" cx="31" cy="92" r="2.6" fill="#4fd8a0" />
  <rect x="24" y="136" width="14" height="6" rx="1.5" fill="#0c0b22" stroke="#ffffff" stroke-opacity="0.12" />
  <rect x="24" y="150" width="14" height="6" rx="1.5" fill="#0c0b22" stroke="#ffffff" stroke-opacity="0.12" />

  <!-- Baias de disco -->
  {
    bays.map((i) => {
      const x = 68 + i * 33;
      return (
        <g>
          <rect x={x} y="30" width="29" height="140" rx="3" fill="url(#srv-bay)" stroke="#ffffff" stroke-opacity="0.09" />
          <rect x={x + 5} y="38" width="19" height="98" rx="2" fill="#0f0e2c" fill-opacity="0.55" />
          <path d={`M${x + 9} 52h11M${x + 9} 57h11M${x + 9} 62h11`} stroke="#ffffff" stroke-opacity="0.12" stroke-width="1.2" stroke-linecap="round" />
          <circle class="srv-led srv-led--blink" cx={x + 10} cy="153" r="2.2" fill={i === 7 ? '#f98305' : '#4fd8a0'} style={`animation-delay:${ledDelay[i]}s`} />
          <circle cx={x + 19} cy="153" r="2.2" fill="#ffffff" fill-opacity="0.16" />
        </g>
      );
    })
  }

  <!-- Painel ventilado e visor -->
  <rect x="470" y="30" width="186" height="140" rx="4" fill="#141336" stroke="#ffffff" stroke-opacity="0.08" />
  <rect x="478" y="38" width="170" height="92" rx="3" fill="url(#srv-perf)" />
  <rect x="478" y="140" width="96" height="22" rx="3" fill="#0b0a20" stroke="#4eb3f4" stroke-opacity="0.35" />
  <path class="srv-trace" d="M484 156 L496 156 L500 146 L506 160 L512 150 L518 154 L528 154 L534 144 L540 158 L546 152 L568 152" stroke="#4eb3f4" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="582" y="140" width="66" height="22" rx="3" fill="#0b0a20" stroke="#ffffff" stroke-opacity="0.1" />
  <circle cx="595" cy="151" r="3" fill="#f98305" />
  <path d="M605 151h33" stroke="#ffffff" stroke-opacity="0.22" stroke-width="2" stroke-linecap="round" />

  <!-- Orelha direita -->
  <rect x="666" y="16" width="46" height="168" rx="10" fill="#17163d" />
  <circle class="srv-led srv-led--steady" cx="689" cy="48" r="2.6" fill="#4fd8a0" />
  <path d="M681 70h16M681 76h16M681 82h10" stroke="#ffffff" stroke-opacity="0.16" stroke-width="1.5" stroke-linecap="round" />
  <rect x="680" y="138" width="18" height="18" rx="4" stroke="#ffffff" stroke-opacity="0.16" />
</svg>

<style>
  .server-illustration {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .srv-led--blink {
      animation: srv-blink 2.8s steps(1, end) infinite;
    }

    .srv-trace {
      stroke-dasharray: 120;
      animation: srv-trace 5s linear infinite;
    }
  }

  @keyframes srv-blink {
    0%,
    100% {
      opacity: 1;
    }
    12% {
      opacity: 0.25;
    }
    18% {
      opacity: 1;
    }
    54% {
      opacity: 0.35;
    }
    58% {
      opacity: 1;
    }
  }

  @keyframes srv-trace {
    from {
      stroke-dashoffset: 240;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
