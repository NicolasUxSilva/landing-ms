# Copie para .env.production e ajuste antes do build de produção.

# Envio do formulário do simulador:
#   elementor -> formulário Elementor Pro da página /orcamento/ (padrão em produção)
#   mock      -> endpoint local de teste (padrão em npm run dev)
#   disabled  -> sem formulário; apenas WhatsApp e e-mail
PUBLIC_LEAD_MODE=elementor
# Endpoint do WordPress (mesmo domínio). Só altere se o admin-ajax estiver em outro caminho.
PUBLIC_LEAD_ENDPOINT=/wp-admin/admin-ajax.php

# Container do Google Tag Manager já usado em msserver.com.br.
# Deixe vazio se a página for servida dentro do WordPress (o tema já carrega o GTM).
PUBLIC_GTM_ID=GTM-KTDRRP3

# Caminho de publicação (base dos assets). Ex.: /servidores-dedicados-para-empresas
BASE_PATH=/

# Use "true" em homologação para impedir indexação (o canonical continua
# apontando para a URL oficial).
PUBLIC_NOINDEX=false
